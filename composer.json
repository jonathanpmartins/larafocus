{
    "name": "jonathanpmartins/larafocus",
    "description": "Laravel Package for integration with FocusNFe API.",
    "license": "MIT",
    "version": "0.1.0",
    "authors": [
        {
            "name": "Jonathan Martins",
            "email": "web@jonathanmartins.com.br"
        }
    ],
    "homepage": "https://github.com/jonathanpmartins/larafocus",
    "support": {
        "issues": "https://github.com/jonathanpmartins/larafocus/issues",
        "source": "https://github.com/jonathanpmartins/larafocus"
    },
    "keywords": [
        "focus",
        "nfse",
        "api",
        "integration",
        "laravel",
        "php",
        "pms"
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-curl": "*",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/validation": "^11.0|^12.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "orchestra/testbench": "^10.0",
        "vlucas/phpdotenv": "^5.6",
        "phpstan/phpstan": "^2.1",
        "larastan/larastan": "^3.9",
        "rector/rector": "^2.3",
        "driftingly/rector-laravel": "^2.1",
        "laravel/pint": "^1.27",
        "pestphp/pest-plugin-type-coverage": "^3.6",
        "pestphp/pest-plugin-stressless": "^3.1",
        "pestphp/pest-plugin-mutate": "^3.0",
        "vimeo/psalm": "^6.15"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "autoload": {
        "psr-4": {
            "Larafocus\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Larafocus\\LarafocusServiceProvider"
            ],
            "aliases": {
                "Focus": "Larafocus\\Focus"
            }
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve"
        ],
        "lint": [
            "@php vendor/bin/phpstan analyse"
        ],
        "test": [
            "@php vendor/bin/pest"
        ]
    }
}
